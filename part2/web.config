<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/servidor.js" verb="*" modules="iisnode" />
    </handlers>

    <iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe" />

    <rewrite>
      <rules>
        <rule name="NodeJS" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="src/servidor.js" />
        </rule>
      </rules>
    </rewrite>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>